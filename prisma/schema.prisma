generator client {
  provider            = "prisma-client"
  output              = "../src/common/database/generated"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Tournament {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  startsAt    DateTime              @db.Timestamptz(3)
  endsAt      DateTime              @db.Timestamptz(3)
  finalizedAt DateTime?             @db.Timestamptz(3)
  bets        TournamentBet[]
  placements  TournamentPlacement[]

  @@index([startsAt, endsAt])
  @@index([endsAt])
  @@map("tournaments")
}

model Bet {
  id            String          @id @default(uuid()) @db.Uuid
  externalBetId String          @unique
  playerId      String
  amount        BigInt
  currency      String          @db.VarChar(3)
  createdAt     DateTime        @db.Timestamptz(3)
  tournaments   TournamentBet[]

  @@map("bets")
}

model TournamentBet {
  tournamentId String     @db.Uuid
  betId        String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bet          Bet        @relation(fields: [betId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tournamentId, betId])
  @@index([betId])
  @@map("tournament_bets")
}

model TournamentPlacement {
  tournamentId String     @db.Uuid
  playerId     String
  score        BigInt
  rank         Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tournamentId, playerId])
  @@unique([tournamentId, rank])
  @@map("tournament_placements")
}
